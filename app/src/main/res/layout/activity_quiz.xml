<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:padding="48dp">

    <!-- 答题主区域 -->
    <LinearLayout
        android:id="@+id/layoutQuizContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSubjectBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2563EB"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="【数学】二年级闯关"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="答对本题即可继续观看电视（按返回键可输入家长密码）"
                android:textColor="#64748B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 题目卡片 -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="130dp"
            android:padding="28dp"
            android:text="题目加载中..."
            android:textColor="#F8FAFC"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- 4个选项网格 (2x2) 方便遥控器上下左右键操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpt0"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option_btn"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="24dp"
                    android:text="A. 选项一"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnOpt1"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option_btn"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="24dp"
                    android:text="B. 选项二"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpt2"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option_btn"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="24dp"
                    android:text="C. 选项三"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnOpt3"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option_btn"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="24dp"
                    android:text="D. 选项四"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 答错后的锁定解析面板 (默认隐藏) -->
        <LinearLayout
            android:id="@+id/layoutPenalty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#450A0A"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPenaltyTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回答错误！请认真看解析，锁定倒计时：180 秒"
                android:textColor="#FCA5A5"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="解析内容..."
                android:textColor="#FEF2F2"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
